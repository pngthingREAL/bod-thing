# ---------------- RANKING ----------------

@bot.command()
async def ranking(ctx):

    if not usuarios:
        await ctx.send("🌱 Todavía nadie tiene puntos.")
        return

    ranking = sorted(
        usuarios.items(),
        key=lambda x: x[1]["puntos"],
        reverse=True
    )

    texto = "🏆 **RANKING ECOLÓGICO** 🌎\n\n"

    for posicion, (user_id, datos_usuario) in enumerate(
        ranking[:10],
        start=1
    ):
        try:
            usuario = await bot.fetch_user(int(user_id))
            nombre = usuario.display_name
        except:
            nombre = "Usuario desconocido"

        texto += (
            f"**{posicion}.** {nombre} — "
            f"⭐ {datos_usuario['puntos']} puntos\n"
        )

    await ctx.send(texto)


