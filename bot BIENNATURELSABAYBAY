import discord
from discord.ext import commands
import random
import json
import os

# ---------------- CONFIGURACIÓN ----------------

intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(
    command_prefix="!",
    intents=intents,
    help_command=None
)

ARCHIVO = "eco_datos.json"

# ---------------- BASE DE DATOS ----------------

if os.path.exists(ARCHIVO):
    with open(ARCHIVO, "r", encoding="utf-8") as f:
        usuarios = json.load(f)
else:
    usuarios = {}


def guardar():
    with open(ARCHIVO, "w", encoding="utf-8") as f:
        json.dump(usuarios, f, indent=4, ensure_ascii=False)


def crear_usuario(user_id):
    user_id = str(user_id)

    if user_id not in usuarios:
        usuarios[user_id] = {
            "puntos": 0,
            "reciclados": 0
        }

    return usuarios[user_id]


def nivel(puntos):
    if puntos < 50:
        return "🌱 Brote"
    elif puntos < 150:
        return "🌿 Plantita"
    elif puntos < 300:
        return "🌳 Árbol"
    elif puntos < 600:
        return "🌲 Bosque"
    else:
        return "🌎 GUARDIÁN DEL PLANETA"


