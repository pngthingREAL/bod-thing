materiales = {
    "botella": "♻️ Plástico",
    "botella plastica": "♻️ Plástico",
    "plastico": "♻️ Plástico",
    "lata": "🥫 Metal",
    "carton": "📦 Cartón",
    "caja": "📦 Cartón",
    "papel": "📄 Papel",
    "vidrio": "🍾 Vidrio",
    "frasco": "🍾 Vidrio",
    "periodico": "📰 Papel",
    "revista": "📰 Papel"
}


@bot.command()
async def reciclar(ctx, *, objeto=None):

    if objeto is None:
        await ctx.send(
            "♻️ Escribe algo después del comando.\n"
            "Ejemplo: `!reciclar botella`"
        )
        return

    objeto = objeto.lower().strip()

    if objeto in materiales:
        tipo = materiales[objeto]

        await ctx.send(
            f"♻️ **{objeto.upper()}**\n"
            f"➡️ Categoría: {tipo}\n\n"
            "🌱 ¡Recuerda limpiarlo y separarlo correctamente "
            "según las reglas de reciclaje de tu localidad!"
        )

    else:
        await ctx.send(
            f"🤔 No tengo registrado **{objeto}**.\n"
            "Puedes preguntarle a alguien de tu localidad cómo "
            "debe desecharse correctamente."
        )


# ---------------- REGISTRAR RECICLAJE ----------------

@bot.command()
async def recicle(ctx, *, objeto=None):
    if objeto is None:
        await ctx.send(
            "♻️ Usa: `!reciclé botella`"
        )
        return

    user = crear_usuario(ctx.author.id)

    puntos = random.randint(5, 20)

    user["puntos"] += puntos
    user["reciclados"] += 1

    guardar()

    await ctx.send(
        f"♻️ **¡RECICLAJE REGISTRADO!**\n\n"
        f"📦 Objeto: **{objeto}**\n"
        f"⭐ +{puntos} puntos verdes\n"
        f"🌱 Total: **{user['puntos']} puntos**\n\n"
        f"¡Bien hecho, {ctx.author.mention}! 🌎"
    )


